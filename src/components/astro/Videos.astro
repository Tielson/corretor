---
/**
 * Vídeos agrupados por finalidade. Nada é carregado do YouTube/Vimeo antes
 * do clique; a capa é local e o link externo fica sempre disponível.
 */
import { getImage } from 'astro:assets';
import type { Video, VideoPurpose } from '@/types/media';
import { resolveImage } from '@/lib/images';
import { VideoFacade } from '@/components/react/VideoFacade';

interface Props {
  videos: Video[];
}

const { videos } = Astro.props;

const PURPOSE_LABEL: Record<VideoPurpose, string> = {
  aerea: 'Visão aérea',
  acesso: 'Acesso ao local',
  apresentacao: 'Apresentação',
  infraestrutura: 'Infraestrutura',
  planta: 'Explicação da planta',
};
const order: VideoPurpose[] = ['aerea', 'acesso', 'apresentacao', 'infraestrutura', 'planta'];

const withCovers = await Promise.all(
  videos.map(async (v) => {
    const meta = resolveImage(v.thumbnail);
    if (!meta) return { video: v, cover: null };
    const img = await getImage({ src: meta, width: 960, format: 'webp', quality: 70 });
    return { video: v, cover: { src: img.src, width: 960, height: Math.round((960 * meta.height) / meta.width) } };
  }),
);
const groups = order
  .map((p) => ({ purpose: p, label: PURPOSE_LABEL[p], items: withCovers.filter((x) => x.video.purpose === p) }))
  .filter((g) => g.items.length > 0);
---

<div class="space-y-8">
  {
    groups.map((g) => (
      <div>
        <h3 class="text-[1.02rem]">{g.label}</h3>
        <div class="mt-3 grid gap-6 md:grid-cols-2">
          {g.items.map(({ video, cover }) => (
            <VideoFacade client:visible video={video} cover={cover} />
          ))}
        </div>
      </div>
    ))
  }
</div>

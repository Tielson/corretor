---
/**
 * Condições comerciais: somente os campos fornecidos. Preço total, entrada
 * e parcelas ficam visualmente separados; a parcela nunca aparece como preço.
 */
import type { Listing } from '@/types/listing';
import { formatCents } from '@/lib/money';
import { formatDateLong } from '@/lib/date';
import { priceInfo } from '@/lib/listing';
import InfoRow from './InfoRow.astro';

interface Props {
  listing: Listing;
  askRef: { kind: 'terreno' | 'empreendimento'; title: string; code: string; url: string };
}

const { listing, askRef } = Astro.props;
const c = listing.commercial;
const p = priceInfo(listing);
const priceLabel = p.mode === 'a_partir_de' ? 'Lotes a partir de' : 'Preço total';
---

{
  c === null ? (
    <dl>
      <InfoRow label="Condições comerciais" value={null} listing={askRef} />
    </dl>
  ) : (
    <div>
      <div class="grid gap-3 sm:grid-cols-3">
        <div class="rounded-xl bg-areia-100 p-4">
          <p class="text-[0.85rem] text-nevoa">{priceLabel}</p>
          <p class="type-data mt-1 text-2xl font-[620] text-mata">{p.cents === null ? 'Sob consulta' : formatCents(p.cents)}</p>
          {listing.kind === 'empreendimento' && <p class="mt-1 text-[0.8rem] text-nevoa">Cada lote tem preço próprio. Veja a lista de lotes.</p>}
        </div>
        {c.downPaymentCents !== null && (
          <div class="rounded-xl border border-border p-4">
            <p class="text-[0.85rem] text-nevoa">Entrada</p>
            <p class="type-data mt-1 text-lg font-[560] text-grafite">{formatCents(c.downPaymentCents)}</p>
          </div>
        )}
        {c.installments !== null && (
          <div class="rounded-xl border border-border p-4">
            <p class="text-[0.85rem] text-nevoa">Parcelamento do saldo</p>
            <p class="type-data mt-1 text-lg font-[560] text-grafite">
              {c.installmentCents !== null
                ? `${c.installments} × ${formatCents(c.installmentCents)}`
                : `Até ${c.installments} parcelas`}
            </p>
            {c.installmentCents === null && <p class="mt-1 text-[0.8rem] text-nevoa">Valor da parcela não informado.</p>}
          </div>
        )}
      </div>
      <dl class="mt-4">
        {c.adjustments && <InfoRow label="Reajustes" value={c.adjustments} />}
        {c.charges && <InfoRow label="Encargos e taxas" value={c.charges} />}
      </dl>
      <p class="mt-3 text-[0.82rem] text-nevoa">
        Condições informadas pelo responsável em {formatDateLong(c.updatedAt)}. Confirme valores e disponibilidade com o
        corretor antes de negociar.
      </p>
    </div>
  )
}

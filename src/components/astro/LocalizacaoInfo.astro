---
/**
 * Bloco estático de localização: continua visível mesmo se o mapa não carregar.
 * Endereço, referências, precisão, links do Google Maps e distâncias estimadas.
 */
import type { Listing } from '@/types/listing';
import { mapLinks } from '@/lib/maps';
import { formatMinutes } from '@/lib/date';
import InfoRow from './InfoRow.astro';

interface Props {
  listing: Listing;
  askRef: { kind: 'terreno' | 'empreendimento'; title: string; code: string; url: string };
}

const { listing, askRef } = Astro.props;
const loc = listing.location;
const links = mapLinks(loc);
const nf = (n: number) => n.toLocaleString('pt-BR', { maximumFractionDigits: 1 });
---

<div class="space-y-5">
  {
    loc.precision === 'aproximada' && (
      <p class="rounded-xl border border-st-reservado/30 bg-st-reservado-bg px-4 py-3 text-[0.92rem] text-st-reservado">
        Localização aproximada. O ponto no mapa indica a região; a posição exata é informada pelo corretor.
      </p>
    )
  }
  <dl>
    <InfoRow label="Endereço" value={loc.addressText} listing={askRef} />
    <InfoRow
      label="Referências"
      value={loc.references.length ? loc.references.join('. ') + '.' : null}
      listing={askRef}
    />
    <InfoRow label="Município" value={`${listing.municipio}, ${listing.uf}`} />
  </dl>

  <div class="flex flex-wrap gap-3">
    <a
      href={links.open}
      target="_blank"
      rel="noopener"
      class="inline-flex h-11 items-center rounded-[10px] border border-input px-4 font-[560] text-mata hover:border-mata hover:bg-areia-100"
    >
      Abrir no Google Maps
    </a>
    <a
      href={links.directions}
      target="_blank"
      rel="noopener"
      class="inline-flex h-11 items-center rounded-[10px] bg-mata px-4 font-[560] text-cal hover:bg-mata-900"
    >
      Traçar rota
    </a>
  </div>
  <p class="text-[0.85rem] text-nevoa">
    {
      links.route.usesEntrance
        ? 'A rota leva ao ponto de entrada informado, que é diferente do centro do terreno.'
        : links.route.warning ?? 'A rota leva ao centro do terreno cadastrado.'
    }
  </p>

  {
    loc.distances.length > 0 ? (
      <div>
        <h3 class="text-[1.02rem]">Distâncias até pontos de referência</h3>
        <ul class="mt-3 divide-y divide-border/70 border-y border-border/70">
          {loc.distances.map((d) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 py-2.5">
              <span>{d.label}</span>
              <span class="type-data text-grafite">
                {nf(d.km)} km{d.minutes !== null && <span class="text-nevoa">, cerca de {formatMinutes(d.minutes)}</span>}
              </span>
            </li>
          ))}
        </ul>
        <p class="mt-2 text-[0.8rem] text-nevoa">
          {loc.distances.every((d) => d.nature === 'estimativa') ? 'Estimativas' : 'Valores'} de{' '}
          {[...new Set(loc.distances.map((d) => d.source))].join(', ')}. Não consideram trânsito nem clima.
        </p>
      </div>
    ) : (
      <dl>
        <InfoRow label="Distâncias até cidades de referência" value={null} listing={askRef} />
      </dl>
    )
  }
</div>

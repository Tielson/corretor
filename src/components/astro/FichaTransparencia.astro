---
/** Quais informações foram confirmadas e quais faltam, com uma pergunta única ao corretor. */
import type { Listing } from '@/types/listing';
import { transparencyReport } from '@/lib/transparency';
import { messages } from '@/lib/whatsapp';
import WaButton from './WaButton.astro';

interface Props {
  listing: Listing;
  url: string;
}

const { listing, url } = Astro.props;
const r = transparencyReport(listing);
const pct = Math.round((r.confirmed / r.total) * 100);
const message = messages.pendencias({
  kind: listing.kind,
  title: listing.title,
  code: listing.code,
  url,
  missing: r.missing.map((m) => m.label),
});
---

<section aria-labelledby="transparencia-titulo" class="rounded-2xl border border-border bg-card p-5 sm:p-6">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="transparencia-titulo" class="text-lg">Informações do anúncio</h2>
    <p class="type-data text-[0.95rem] text-grafite">
      <strong class="font-[640] text-mata">{r.confirmed}</strong> de {r.total} confirmadas
    </p>
  </div>
  <div
    class="mt-3 h-2 overflow-hidden rounded-full bg-areia-100"
    role="img"
    aria-label={`${r.confirmed} de ${r.total} informações confirmadas`}
  >
    <div class="h-full rounded-full bg-folha" style={`width:${pct}%`}></div>
  </div>
  {
    r.missing.length > 0 ? (
      <>
        <p class="mt-4 text-[0.92rem] text-grafite/85">Ainda não disponibilizado:</p>
        <ul class="mt-2 flex flex-wrap gap-2">
          {r.missing.map((m) => (
            <li>
              <a
                href={`#${m.anchor}`}
                class="inline-flex rounded-md border border-dashed border-input px-2.5 py-1 text-[0.85rem] text-grafite/85 hover:border-mata hover:text-mata"
              >
                {m.label}
              </a>
            </li>
          ))}
        </ul>
        <WaButton message={message} variant="secondary" size="sm" class="mt-4">
          Perguntar sobre os itens pendentes
        </WaButton>
      </>
    ) : (
      <p class="mt-4 text-[0.92rem] text-grafite/85">Todas as informações da ficha foram fornecidas pelo responsável.</p>
    )
  }
</section>

---
/** Infraestrutura em três grupos separados: existente, prevista e não informada. */
import type { Infrastructure } from '@/types/infrastructure';

interface Props {
  infrastructure: Infrastructure;
}

const { infrastructure } = Astro.props;
const groups = [
  { status: 'existente', title: 'Existente', hint: 'Já instalada, segundo o responsável.', mark: '✓', cls: 'text-st-disponivel' },
  { status: 'prevista', title: 'Prevista', hint: 'Prometida, ainda não existe. Não conta nos filtros.', mark: '◔', cls: 'text-st-reservado' },
  { status: 'nao_informada', title: 'Não informada', hint: 'Sem informação cadastrada.', mark: '?', cls: 'text-st-consulta' },
] as const;
---

<div class="grid gap-4 md:grid-cols-3">
  {
    groups.map((g) => {
      const items = infrastructure.items.filter((i) => i.status === g.status);
      return (
        <div class="rounded-xl border border-border bg-card p-4">
          <h3 class="flex items-center gap-2 text-[1.02rem]">
            <span class:list={['type-data text-base', g.cls]} aria-hidden="true">
              {g.mark}
            </span>
            {g.title}
            <span class="type-data ml-auto text-[0.85rem] font-normal text-nevoa">{items.length}</span>
          </h3>
          <p class="mt-1 text-[0.8rem] text-nevoa">{g.hint}</p>
          {items.length > 0 ? (
            <ul class="mt-3 space-y-2">
              {items.map((i) => (
                <li class="text-[0.95rem]">
                  {i.label}
                  {i.note && <span class="block text-[0.82rem] text-nevoa">{i.note}</span>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 text-[0.9rem] text-nevoa">Nenhum item neste grupo.</p>
          )}
        </div>
      );
    })
  }
</div>
